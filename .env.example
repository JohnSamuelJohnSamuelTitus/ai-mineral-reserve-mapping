# ==============================================================================
# AI Mineral Reserve Mapping Assistant — Environment Configuration Template
# Copy to `.env` for local development. NEVER commit `.env` or real secrets.
# ==============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=ai-mineral-prospectivity-assistant
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL / PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mineral_prospectivity
POSTGRES_USER=prospectivity_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
DATABASE_URL=postgresql+psycopg://prospectivity_app:CHANGE_ME_LOCAL_DEV_PASSWORD@localhost:5432/mineral_prospectivity

# --- Redis / Task Queue (Phase 3+) ---
REDIS_URL=redis://localhost:6379/0

# --- Satellite & Geospatial APIs (Optional / Key-Gated) ---
# Microsoft Planetary Computer (no key required for search; SAS signing automated via SDK)
MPC_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Copernicus Data Space Ecosystem (OAuth2 client credentials — free registration)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# NASA Earthdata Login (required for EMIT / ASTER asset downloads)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_TOKEN=

# OpenTopography (free API key required for /globaldem)
OPENTOPOGRAPHY_API_KEY=

# USGS EROS M2M / ERS (optional if pulling Landsat directly instead of MPC)
USGS_ERS_USERNAME=
USGS_ERS_TOKEN=

# Mindat.org (optional; non-commercial approval required; ML training restricted)
MINDAT_API_KEY=

# --- Scientific Literature & Geocoding APIs ---
# OpenAlex (optional free key increases daily budget from shared $0.10 to $1.00/day)
OPENALEX_API_KEY=
OPENALEX_MAILTO=researcher@example.org

# OSM Nominatim (custom User-Agent required by usage policy)
NOMINATIM_USER_AGENT=AIMineralProspectivityAssistant/0.1 (contact@example.org)

# --- AI Geological Assistant (LLM Provider) ---
# Supports OpenAI-compatible or Gemini API endpoints (configure in Phase 4)
LLM_PROVIDER=gemini
LLM_MODEL=
LLM_API_KEY=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional Cesium ion token for Cesium World Terrain (CesiumJS library works without it using open terrain/imagery)
VITE_CESIUM_ION_TOKEN=

